# =============================================================================
# Walk With Us — Environment Configuration Template
# =============================================================================
# Copy this file to .env.local for local frontend development.
# NEVER commit secret keys (e.g. SERVICE_ROLE_KEY or RAZORPAY_KEY_SECRET) to Git.

# -----------------------------------------------------------------------------
# 1. FRONTEND ENVIRONMENT VARIABLES (Vite Client-Side)
# -----------------------------------------------------------------------------
# Supabase project URL (public)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase publishable / anon key (public, safe in browser)
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-or-anon-key
VITE_SUPABASE_ANON_KEY=your-supabase-publishable-or-anon-key

# Razorpay Test Mode Key ID (Optional for client; keyId is returned by Edge Function)
# Keep in test mode (rzp_test_...) until live payments are explicitly authorized.
VITE_RAZORPAY_KEY_ID=rzp_test_your_key_id

# -----------------------------------------------------------------------------
# 2. SERVER-SIDE EDGE FUNCTION SECRETS (Supabase Dashboard / CLI Vault only)
# -----------------------------------------------------------------------------
# These secrets MUST NOT be set in Vite or .env.local!
# Set them via: supabase secrets set KEY=VALUE or inside the Supabase Project Dashboard
#
# RAZORPAY_KEY_ID=rzp_test_...
# RAZORPAY_KEY_SECRET=your_test_secret
# RAZORPAY_WEBHOOK_SECRET=your_webhook_signing_secret
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key
